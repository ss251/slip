# private agent context
CLAUDE.local.md
.claude/settings.local.json

# apple
.DS_Store
xcuserdata/
DerivedData/
*.xcresult

# build artifacts
build/
.build/
target/
node_modules/
dist/

# midnight artifacts (decide tracking policy at first compile; keys may move to LFS)
*.zkir
keys/
params-cache/

# env & logs
.env*
*.log

# generated symlink to compiled contract (recreated by contracts/test/link-build.mjs)
contracts/test/slipcontract

# midskills: sources are vendored in .agents/skills/ (tracked); .claude/skills/ are
# symlinks the installer creates for Claude Code discovery — do not track those.
.claude/skills/

# python bytecode from scripts/paper-gate.py
__pycache__/
*.pyc

# MidnightKit: the Rust archive is ~60MB and rebuilds from source (scripts/sync-prover.sh)
MidnightKit/Vendor/*.a
MidnightKit/.build/

# living handoff documents for agent-to-agent continuation (enforced by hooks)
handoff/
